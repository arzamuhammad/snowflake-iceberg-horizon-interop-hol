{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IcebergObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::<your-bucket>/lakehouse/*"
    },
    {
      "Sid": "IcebergBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::<your-bucket>",
      "Condition": { "StringLike": { "s3:prefix": ["lakehouse/*"] } }
    }
  ]
}
